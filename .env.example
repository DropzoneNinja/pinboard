# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Postgres ---
POSTGRES_USER=pinboard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pinboard

# --- Backend ---
NODE_ENV=production
# Max upload size, in MB, enforced by the backend (keep nginx client_max_body_size in sync).
MAX_UPLOAD_MB=15
# Refresh token lifetime, in days.
REFRESH_TOKEN_TTL_DAYS=90
# Secrets used to sign access/refresh tokens. Generate with: openssl rand -hex 32
ACCESS_TOKEN_SECRET=change-me
REFRESH_TOKEN_SECRET=change-me

# --- Nginx / public entry point ---
# Host port nginx is published on. Put an existing HTTPS reverse proxy in front of this.
HTTP_PORT=8080

# --- Deployment image tag ---
# Which GHCR image tag to run: "latest", a short git sha, or a semver release tag.
IMAGE_TAG=latest
